{
  "$defs": {
    "Component": {
      "additionalProperties": false,
      "properties": {
        "feeds": {
          "items": {
            "$ref": "#/$defs/Feed"
          },
          "type": "array"
        },
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "upstream": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "$ref": "#/$defs/Usage",
          "default": "tracked"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "type": "object"
    },
    "Feed": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/FeedKind"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "type": "object"
    },
    "FeedKind": {
      "enum": [
        "csaf",
        "vex",
        "rss",
        "atom"
      ],
      "type": "string"
    },
    "FileReview": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/ReviewCoverage"
        },
        "file_id": {
          "type": "string"
        },
        "offset": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "packages": {
          "items": {
            "$ref": "#/$defs/PackageObservation"
          },
          "type": "array"
        },
        "rationale": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "offset",
        "sha256",
        "rationale",
        "coverage",
        "packages"
      ],
      "type": "object"
    },
    "IdentityObservation": {
      "additionalProperties": false,
      "properties": {
        "cpe_product": {
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceMapping"
          },
          "type": "array"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "instance_id",
        "fingerprint",
        "rationale",
        "sources"
      ],
      "type": "object"
    },
    "MappingState": {
      "enum": [
        "mapped",
        "unavailable",
        "not_applicable"
      ],
      "type": "string"
    },
    "PackageObservation": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "$ref": "#/$defs/Component"
        },
        "excerpt": {
          "type": "string"
        },
        "version_excerpt": {
          "description": "Literal version definition from the same chunk when `excerpt` references it through a\n`${name}` placeholder (for example a Maven `<properties>` entry).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "component",
        "excerpt"
      ],
      "type": "object"
    },
    "ReviewCoverage": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ],
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "website",
        "repository",
        "issues",
        "proposed_changes",
        "discussions",
        "documentation",
        "changelog",
        "releases",
        "advisories"
      ],
      "type": "string"
    },
    "SourceMapping": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "state": {
          "$ref": "#/$defs/MappingState"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "state",
        "detail",
        "evidence"
      ],
      "type": "object"
    },
    "Usage": {
      "enum": [
        "tracked",
        "deployed"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "const": "workspace",
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "reviews": {
          "items": {
            "$ref": "#/$defs/FileReview"
          },
          "type": "array"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scope_sha256": {
          "type": "string"
        }
      },
      "required": [
        "phase",
        "schema_version",
        "project_id",
        "scope_sha256",
        "reviews"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "observations": {
          "items": {
            "$ref": "#/$defs/IdentityObservation"
          },
          "type": "array"
        },
        "phase": {
          "const": "sources",
          "type": "string"
        },
        "project_id": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scope_sha256": {
          "type": "string"
        }
      },
      "required": [
        "phase",
        "schema_version",
        "project_id",
        "scope_sha256",
        "observations"
      ],
      "type": "object"
    }
  ],
  "title": "DiscoveryBatch"
}
