{
  "$defs": {
    "ArchiveEcosystem": {
      "enum": [
        "cargo",
        "npm"
      ],
      "type": "string"
    },
    "ArtifactEvidence": {
      "additionalProperties": false,
      "description": "A checksummed artifact and optional evidence of its installed contents.",
      "properties": {
        "codebase": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "installed_archive": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstalledArchiveEvidence"
            },
            {
              "type": "null"
            }
          ],
          "description": "Installed Cargo or npm package checked against its lockfile archive."
        },
        "installed_wheel": {
          "anyOf": [
            {
              "$ref": "#/$defs/InstalledScopeEvidence"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact installed wheel files and paths checked within the monitored codebase."
        },
        "instance_id": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/ArtifactLocation"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "codebase",
        "location",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "ArtifactLocation": {
      "oneOf": [
        {
          "const": "codebase",
          "description": "Path relative to the selected codebase.",
          "type": "string"
        },
        {
          "const": "monitor_workspace",
          "description": "Path relative to the monitor profile's directory.",
          "type": "string"
        }
      ]
    },
    "ArtifactScopeSource": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "description": "One-based line number.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "line_sha256": {
          "description": "SHA-256 of the line without its line ending.",
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "line",
        "line_sha256"
      ],
      "type": "object"
    },
    "Assessment": {
      "description": "`not_applicable`: a security claim that, per the cited source, does not affect the monitored\nversion or build. It requires `not_applicable_reason`, is counted and remembered, and opens no case.",
      "enum": [
        "review",
        "informational",
        "not_applicable",
        "ignore"
      ],
      "type": "string"
    },
    "CodebaseRevision": {
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "codebase": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "description": "Changes excluding private paths, ignored files, generated untracked files and submodules.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "observed_at": {
          "type": "string"
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/RepositoryState"
        },
        "worktree_status_sha256": {
          "description": "Hash of Git's status entries and changed files, without retaining names or contents.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "codebase",
        "state",
        "observed_at"
      ],
      "type": "object"
    },
    "InstalledArchiveEvidence": {
      "additionalProperties": false,
      "properties": {
        "ecosystem": {
          "$ref": "#/$defs/ArchiveEcosystem"
        },
        "scope": {
          "$ref": "#/$defs/InstalledScopeEvidence"
        }
      },
      "required": [
        "ecosystem",
        "scope"
      ],
      "type": "object"
    },
    "InstalledScopeEvidence": {
      "additionalProperties": false,
      "properties": {
        "absent_paths": {
          "description": "Paths or bounded filename patterns relative to the installed directory checked for absence.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "root": {
          "description": "Codebase-relative installed package or source directory.",
          "type": "string"
        },
        "scope_complete": {
          "description": "The source and note support this installation for every in-scope build using the instance.",
          "type": "boolean"
        },
        "scope_evidence_id": {
          "description": "Case evidence describing why this directory represents the assessed build or test scope.",
          "type": "string"
        },
        "scope_source": {
          "$ref": "#/$defs/ArtifactScopeSource",
          "description": "Current source line supporting the scope described in the case evidence."
        }
      },
      "required": [
        "root",
        "absent_paths",
        "scope_evidence_id",
        "scope_complete",
        "scope_source"
      ],
      "type": "object"
    },
    "ItemDecision": {
      "additionalProperties": false,
      "properties": {
        "all_instances": {
          "default": false,
          "description": "Explicitly assess every instance of a multi-component upstream as one scope.",
          "type": "boolean"
        },
        "artifact_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "assessment": {
          "$ref": "#/$defs/Assessment"
        },
        "codebase_revisions": {
          "description": "Codebase revisions reported by `tools hits` for this reading.",
          "items": {
            "$ref": "#/$defs/CodebaseRevision"
          },
          "type": "array"
        },
        "context_sha256": {
          "description": "Context fingerprint returned by tools hits for the exact reviewed target.",
          "type": "string"
        },
        "instance_ids": {
          "default": [],
          "description": "Instances of the item's upstream the reading applies to.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "key": {
          "description": "Item key reported by `tools hits`.",
          "type": "string"
        },
        "not_applicable_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/NotApplicableReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required with `not_applicable`; forbidden otherwise."
        },
        "rationale": {
          "type": "string"
        },
        "reviewed_instance_ids": {
          "description": "Candidate instances actually examined for this item.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source_facts": {
          "$ref": "#/$defs/SourceFacts",
          "default": {
            "affected_versions": "",
            "fix_reference": "",
            "fixed_in": "",
            "identifiers": [],
            "required_feature": ""
          }
        },
        "updated_at": {
          "description": "The item's `updated_at` when it was reviewed; a later update lists the item again.",
          "type": "string"
        },
        "upstream": {
          "description": "Upstream reported by `tools hits`.",
          "type": "string"
        }
      },
      "required": [
        "upstream",
        "key",
        "updated_at",
        "context_sha256",
        "codebase_revisions",
        "assessment",
        "rationale",
        "reviewed_instance_ids"
      ],
      "type": "object"
    },
    "NotApplicableReason": {
      "oneOf": [
        {
          "const": "fixed_in_monitored_version",
          "description": "The monitored resolved version already contains the fix.",
          "type": "string"
        },
        {
          "const": "affects_other_version",
          "description": "Only other release lines or unreleased branches are affected.",
          "type": "string"
        },
        {
          "const": "component_not_in_build",
          "description": "The affected module, feature or platform is absent from the monitored build.",
          "type": "string"
        }
      ]
    },
    "RepositoryState": {
      "enum": [
        "git",
        "not_git",
        "unavailable"
      ],
      "type": "string"
    },
    "SourceFacts": {
      "additionalProperties": false,
      "description": "What an upstream item itself states, quoted or closely paraphrased; an empty field means the\nitem does not say. These are the item's statements, not the agent's conclusions.",
      "properties": {
        "affected_versions": {
          "default": "",
          "description": "Versions or release lines the item says are affected.",
          "type": "string"
        },
        "fix_reference": {
          "default": "",
          "description": "Pull request, commit or release that carries the fix.",
          "type": "string"
        },
        "fixed_in": {
          "default": "",
          "description": "Version, release or backport the item says contains the fix.",
          "type": "string"
        },
        "identifiers": {
          "default": [],
          "description": "CVE, GHSA, RUSTSEC or other advisory IDs the item cites.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "required_feature": {
          "default": "",
          "description": "Feature, configuration or deployment condition the item says the issue requires.",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The agent's reviewed readings of screened items, kept across runs.",
  "properties": {
    "decisions": {
      "items": {
        "$ref": "#/$defs/ItemDecision"
      },
      "type": "array"
    },
    "project_id": {
      "description": "Monitor that owns these decisions.",
      "type": "string"
    },
    "recheck": {
      "description": "Whether these decisions belong to an explicit recheck.",
      "type": "boolean"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "recheck",
    "decisions"
  ],
  "title": "ResearchDecisions",
  "type": "object"
}
