{
  "$defs": {
    "Alerts": {
      "additionalProperties": false,
      "properties": {
        "webhook_env": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "feeds": {
          "items": {
            "$ref": "#/$defs/Feed"
          },
          "type": "array"
        },
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "upstream": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "$ref": "#/$defs/Usage",
          "default": "tracked"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "DiscoveryMode": {
      "enum": [
        "agent",
        "off"
      ],
      "type": "string"
    },
    "Feed": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/FeedKind"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "type": "object"
    },
    "FeedKind": {
      "enum": [
        "csaf",
        "vex",
        "rss",
        "atom"
      ],
      "type": "string"
    },
    "Language": {
      "enum": [
        "en",
        "es"
      ],
      "type": "string"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "$ref": "#/$defs/Language",
          "default": "en",
          "description": "Language of the rendered report and of every rationale the agent records for it. Technical\nterms without a common translation in that language stay as they are."
        }
      },
      "type": "object"
    },
    "Research": {
      "additionalProperties": false,
      "properties": {
        "topics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "type": "array"
        },
        "web": {
          "$ref": "#/$defs/WebResearch",
          "default": "off"
        }
      },
      "type": "object"
    },
    "Schedule": {
      "enum": [
        "daily",
        "weekdays",
        "weekly"
      ],
      "type": "string"
    },
    "Usage": {
      "enum": [
        "tracked",
        "deployed"
      ],
      "type": "string"
    },
    "WebResearch": {
      "enum": [
        "agent",
        "off"
      ],
      "type": "string"
    }
  },
  "$id": "urn:vulnbell:schema:profile:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "$ref": "#/$defs/Alerts",
      "default": {}
    },
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "type": "array"
    },
    "discovery": {
      "$ref": "#/$defs/DiscoveryMode",
      "default": "agent"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/Report",
      "default": {
        "language": "en"
      }
    },
    "research": {
      "$ref": "#/$defs/Research",
      "default": {
        "topics": [],
        "web": "off"
      }
    },
    "schedule": {
      "anyOf": [
        {
          "$ref": "#/$defs/Schedule"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "const": 1
    },
    "workspaces": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "project_id",
    "name"
  ],
  "title": "Profile",
  "type": "object"
}
