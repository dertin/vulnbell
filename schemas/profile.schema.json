{
  "$defs": {
    "Alerts": {
      "additionalProperties": false,
      "properties": {
        "webhook_env": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "feeds": {
          "items": {
            "$ref": "#/$defs/Feed"
          },
          "type": "array"
        },
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "upstream": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "$ref": "#/$defs/Usage",
          "default": "tracked"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "ref"
      ],
      "type": "object"
    },
    "DiscoveryMode": {
      "enum": [
        "agent",
        "off"
      ],
      "type": "string"
    },
    "Feed": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/FeedKind"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "type": "object"
    },
    "FeedKind": {
      "enum": [
        "csaf",
        "vex",
        "rss",
        "atom"
      ],
      "type": "string"
    },
    "Language": {
      "enum": [
        "en",
        "es"
      ],
      "type": "string"
    },
    "Report": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "$ref": "#/$defs/Language",
          "default": "en",
          "description": "Language of the rendered report and of every rationale the agent records for it. Technical\nterms without a common translation in that language stay as they are."
        }
      },
      "type": "object"
    },
    "Research": {
      "additionalProperties": false,
      "properties": {
        "follow": {
          "description": "Exact inventory references explicitly selected for deeper tracker research.",
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "type": "array"
        },
        "initial_since": {
          "description": "Optional initial activity window (RFC3339), for example a verified monitored release date.\nAdvisory scans remain independent of this window.",
          "type": [
            "string",
            "null"
          ]
        },
        "release_windows": {
          "default": false,
          "description": "Acquire exact-version release dates from supported official registries for initial windows.",
          "type": "boolean"
        },
        "review_budget_minutes": {
          "description": "Per-monitor review budget. Host agents must stop at the deadline and preserve open work.",
          "format": "uint16",
          "maximum": 120,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "topics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "type": "array"
        },
        "tracker_scope": {
          "$ref": "#/$defs/TrackerScope",
          "default": "direct",
          "description": "Tracker exploration scope; advisory checks continue across the full inventory."
        },
        "web": {
          "$ref": "#/$defs/WebResearch",
          "default": "off"
        }
      },
      "type": "object"
    },
    "SandboxLimits": {
      "additionalProperties": false,
      "description": "Upper bounds a sandbox test may request. Isolation (no network, no host mounts, one CPU,\nunprivileged user, official digest-pinned images) is not configurable.",
      "properties": {
        "max_input_file_mib": {
          "default": 16,
          "format": "uint32",
          "maximum": 512,
          "minimum": 1,
          "type": "integer"
        },
        "max_inputs_mib": {
          "default": 64,
          "description": "Sum of all inputs of one test; the guest root disk is 2 GiB.",
          "format": "uint32",
          "maximum": 1024,
          "minimum": 1,
          "type": "integer"
        },
        "max_memory_mib": {
          "default": 512,
          "format": "uint32",
          "maximum": 4096,
          "minimum": 128,
          "type": "integer"
        },
        "max_timeout_seconds": {
          "default": 120,
          "format": "uint64",
          "maximum": 600,
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Schedule": {
      "enum": [
        "daily",
        "weekdays",
        "weekly"
      ],
      "type": "string"
    },
    "TrackerScope": {
      "enum": [
        "direct",
        "all"
      ],
      "type": "string"
    },
    "Usage": {
      "enum": [
        "tracked",
        "deployed"
      ],
      "type": "string"
    },
    "WebResearch": {
      "enum": [
        "agent",
        "off"
      ],
      "type": "string"
    }
  },
  "$id": "urn:vulnbell:schema:profile:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "$ref": "#/$defs/Alerts",
      "default": {}
    },
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "type": "array"
    },
    "discovery": {
      "$ref": "#/$defs/DiscoveryMode",
      "default": "agent"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "format": "uuid",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/Report",
      "default": {
        "language": "en"
      }
    },
    "research": {
      "$ref": "#/$defs/Research",
      "default": {
        "release_windows": false,
        "topics": [],
        "tracker_scope": "direct",
        "web": "off"
      }
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxLimits"
    },
    "schedule": {
      "anyOf": [
        {
          "$ref": "#/$defs/Schedule"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "const": 1
    },
    "workspaces": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "project_id",
    "name"
  ],
  "title": "Profile",
  "type": "object"
}
