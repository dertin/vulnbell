{
  "$defs": {
    "AdvisoryDetail": {
      "properties": {
        "advisory_id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fixed_versions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "severity": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "advisory_id",
        "description",
        "fixed_versions"
      ],
      "type": "object"
    },
    "Applicability": {
      "enum": [
        "affected",
        "not_affected",
        "possible",
        "unknown",
        "conflict"
      ],
      "type": "string"
    },
    "BlockerKind": {
      "description": "Why a sandbox check the case needs cannot run. Missing deployment facts are not a kind: the\nsandbox cannot establish them, so they never require a check.",
      "oneOf": [
        {
          "const": "details_undisclosed",
          "description": "The advisory or report does not disclose enough to build an oracle.",
          "type": "string"
        },
        {
          "const": "artifact_unavailable",
          "description": "The exact artifact cannot be obtained from an official source with a checksum.",
          "type": "string"
        },
        {
          "const": "sandbox_limits",
          "description": "The artifact or workload exceeds the profile's sandbox limits or their caps.",
          "type": "string"
        },
        {
          "const": "runtime_unavailable",
          "description": "Microsandbox cannot run on this host.",
          "type": "string"
        },
        {
          "const": "authorization_declined",
          "description": "The operator declined to authorize the test.",
          "type": "string"
        }
      ]
    },
    "Coverage": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/CoverageState"
        }
      },
      "required": [
        "source",
        "scope",
        "state",
        "detail"
      ],
      "type": "object"
    },
    "CoverageState": {
      "enum": [
        "checked",
        "partial",
        "unsupported",
        "unavailable",
        "unresolved",
        "disabled"
      ],
      "type": "string"
    },
    "Decision": {
      "enum": [
        "actionable",
        "review",
        "informational",
        "dismissed"
      ],
      "type": "string"
    },
    "DiscoverySummary": {
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "components_unmapped": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "deferred_transitive": {
          "description": "Inventory instances outside the selected tracker-mapping scope.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "deferred_unknown_depth": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "directories_pending": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "files_excluded": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "files_pending": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "files_reviewed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "files_unavailable": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "sources_unavailable": {
          "description": "Mapped components without a repository, so upstream research cannot cover them.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "directories_pending",
        "files_pending",
        "files_reviewed",
        "files_excluded",
        "files_unavailable",
        "components_unmapped",
        "deferred_transitive",
        "deferred_unknown_depth",
        "sources_unavailable",
        "complete"
      ],
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "type": "object"
    },
    "FindingCheck": {
      "properties": {
        "case_id": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImpactResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "local_checks": {
          "items": {
            "$ref": "#/$defs/LocalCheck"
          },
          "type": "array"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/FindingReference"
          },
          "type": "array"
        },
        "review_handoff": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewHandoff"
            },
            {
              "type": "null"
            }
          ],
          "description": "Evidence-bound review disposition; it never represents a sandbox attestation."
        },
        "review_handoff_stale": {
          "description": "A prior disposition is no longer current or its evidence cannot be validated.",
          "type": "boolean"
        }
      },
      "required": [
        "case_id",
        "decision",
        "references",
        "local_checks",
        "review_handoff_stale"
      ],
      "type": "object"
    },
    "FindingReference": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "url"
      ],
      "type": "object"
    },
    "HandoffItem": {
      "properties": {
        "advisory_details": {
          "items": {
            "$ref": "#/$defs/AdvisoryDetail"
          },
          "type": "array"
        },
        "applicability": {
          "$ref": "#/$defs/Applicability"
        },
        "case_id": {
          "type": "string"
        },
        "components": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "detail_gaps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence_links": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence_sha256": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "known_exploited": {
          "type": "boolean"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "origin": {
          "items": {
            "$ref": "#/$defs/Origin"
          },
          "type": "array"
        },
        "provenance": {
          "description": "Where each component version was read: `workspace/path:line`, or the profile.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "recommended_action": {
          "type": "string"
        },
        "recorded_verdict": {
          "description": "Latest recorded agent verdict (`decision: rationale`), when one exists.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_facts": {
          "description": "What the cited upstream items state (affected versions, fix, required feature).",
          "items": {
            "$ref": "#/$defs/SourceFacts"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/Verification"
        }
      },
      "required": [
        "case_id",
        "components",
        "provenance",
        "origin",
        "summary",
        "advisory_details",
        "detail_gaps",
        "applicability",
        "verification",
        "known_exploited",
        "evidence_links",
        "evidence_sha256",
        "open_questions",
        "recommended_action",
        "source_facts"
      ],
      "type": "object"
    },
    "IdentityObservation": {
      "additionalProperties": false,
      "properties": {
        "cpe_product": {
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceMapping"
          },
          "type": "array"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "instance_id",
        "fingerprint",
        "rationale",
        "sources"
      ],
      "type": "object"
    },
    "ImpactAnswer": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "$ref": "#/$defs/ImpactAnswerValue"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "type": "array"
        },
        "instance_id": {
          "type": "string"
        },
        "question": {
          "$ref": "#/$defs/ImpactQuestionId"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "question",
        "answer",
        "rationale"
      ],
      "type": "object"
    },
    "ImpactAnswerValue": {
      "enum": [
        "yes",
        "no",
        "unknown",
        "not_applicable"
      ],
      "type": "string"
    },
    "ImpactConfidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "type": "string"
    },
    "ImpactQuestionId": {
      "enum": [
        "artifact_deployed",
        "affected_feature_used",
        "untrusted_input_reaches_feature",
        "required_conditions_present",
        "fix_or_mitigation_applied"
      ],
      "type": "string"
    },
    "ImpactResult": {
      "properties": {
        "answers": {
          "items": {
            "$ref": "#/$defs/ImpactAnswer"
          },
          "type": "array"
        },
        "assessed_at": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/ImpactConfidence"
        },
        "facts_sha256": {
          "type": "string"
        },
        "instances": {
          "items": {
            "$ref": "#/$defs/InstanceImpact"
          },
          "type": "array"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "verdict": {
          "$ref": "#/$defs/ImpactVerdict"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "facts_sha256",
        "verdict",
        "confidence",
        "answers",
        "instances",
        "assessed_at"
      ],
      "type": "object"
    },
    "ImpactVerdict": {
      "enum": [
        "urgent_update",
        "priority_update",
        "routine_update",
        "mitigated",
        "not_affected",
        "needs_evidence"
      ],
      "type": "string"
    },
    "InstanceImpact": {
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ImpactConfidence"
        },
        "instance_id": {
          "type": "string"
        },
        "open_questions": {
          "items": {
            "$ref": "#/$defs/ImpactQuestionId"
          },
          "type": "array"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "verdict": {
          "$ref": "#/$defs/ImpactVerdict"
        }
      },
      "required": [
        "instance_id",
        "verdict",
        "confidence",
        "reasons",
        "open_questions"
      ],
      "type": "object"
    },
    "Language": {
      "enum": [
        "en",
        "es"
      ],
      "type": "string"
    },
    "LocalCheck": {
      "properties": {
        "artifact_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "attestation_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocker": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockerKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set for a `blocked` result; absent for blockers recorded without a kind."
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/TestContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "$ref": "#/$defs/LocalResult"
        },
        "sandbox_candidate": {
          "description": "An unconfirmed version warrants a review decision; it does not mandate a test.",
          "type": "boolean"
        },
        "sandbox_needed": {
          "description": "A current review disposition explicitly requires a test for this instance.",
          "type": "boolean"
        }
      },
      "required": [
        "instance_id",
        "sandbox_candidate",
        "sandbox_needed",
        "result",
        "detail"
      ],
      "type": "object"
    },
    "LocalResult": {
      "enum": [
        "not_run",
        "blocked",
        "reproduced",
        "not_reproduced",
        "inconclusive",
        "not_applicable",
        "invalid_evidence"
      ],
      "type": "string"
    },
    "MappingState": {
      "enum": [
        "mapped",
        "unavailable",
        "not_applicable"
      ],
      "type": "string"
    },
    "MonitoredComponent": {
      "properties": {
        "instance_id": {
          "type": "string"
        },
        "line": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": "string"
        },
        "requested_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "instance_id",
        "ref",
        "origin"
      ],
      "type": "object"
    },
    "Origin": {
      "enum": [
        "declared",
        "locked",
        "agent_observed",
        "observed_artifact",
        "deployed"
      ],
      "type": "string"
    },
    "PendingReason": {
      "oneOf": [
        {
          "const": "impact_not_assessed",
          "description": "`vulnbell impact` has not been answered for the current case facts.",
          "type": "string"
        },
        {
          "const": "review_disposition_missing",
          "description": "An unconfirmed signal needs an explicit review disposition, not necessarily a test.",
          "type": "string"
        },
        {
          "const": "sandbox_check_missing",
          "description": "A test was explicitly required and has neither a result nor a categorized blocker.",
          "type": "string"
        },
        {
          "const": "invalid_verification_evidence",
          "description": "Recorded verification evidence could not be validated.",
          "type": "string"
        }
      ]
    },
    "PendingVerification": {
      "properties": {
        "case_id": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/PendingReason"
        }
      },
      "required": [
        "case_id",
        "reason"
      ],
      "type": "object"
    },
    "ReviewHandoff": {
      "additionalProperties": false,
      "description": "A reviewed case may be handed off with open uncertainty without requiring a laboratory test.",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "facts_sha256": {
          "type": "string"
        },
        "next_step": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "sandbox_instance_ids": {
          "description": "Explicit test targets; empty only when no sandbox test is required.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sandbox_required": {
          "type": "boolean"
        },
        "uncertainty": {
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "facts_sha256",
        "rationale",
        "uncertainty",
        "next_step",
        "sandbox_required",
        "sandbox_instance_ids",
        "note"
      ],
      "type": "object"
    },
    "SourceFacts": {
      "additionalProperties": false,
      "description": "What an upstream item itself states, quoted or closely paraphrased; an empty field means the\nitem does not say. These are the item's statements, not the agent's conclusions.",
      "properties": {
        "affected_versions": {
          "default": "",
          "description": "Versions or release lines the item says are affected.",
          "type": "string"
        },
        "fix_reference": {
          "default": "",
          "description": "Pull request, commit or release that carries the fix.",
          "type": "string"
        },
        "fixed_in": {
          "default": "",
          "description": "Version, release or backport the item says contains the fix.",
          "type": "string"
        },
        "identifiers": {
          "default": [],
          "description": "CVE, GHSA, RUSTSEC or other advisory IDs the item cites.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "required_feature": {
          "default": "",
          "description": "Feature, configuration or deployment condition the item says the issue requires.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "website",
        "repository",
        "issues",
        "proposed_changes",
        "discussions",
        "documentation",
        "changelog",
        "releases",
        "advisories"
      ],
      "type": "string"
    },
    "SourceMapping": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/SourceKind"
        },
        "state": {
          "$ref": "#/$defs/MappingState"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "state",
        "detail",
        "evidence"
      ],
      "type": "object"
    },
    "TestContext": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/TestMode"
        }
      },
      "required": [
        "mode",
        "description"
      ],
      "type": "object"
    },
    "TestMode": {
      "enum": [
        "workspace_copy",
        "artifact_reproducer"
      ],
      "type": "string"
    },
    "Verification": {
      "enum": [
        "source_confirmed",
        "lab_reproduced",
        "not_reproduced",
        "inconclusive",
        "disproven"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actionable": {
      "items": {
        "$ref": "#/$defs/HandoffItem"
      },
      "type": "array"
    },
    "audience": {
      "type": "string"
    },
    "coverage_gaps": {
      "items": {
        "$ref": "#/$defs/Coverage"
      },
      "type": "array"
    },
    "discovery": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiscoverySummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "dismissed_count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "finding_checks": {
      "items": {
        "$ref": "#/$defs/FindingCheck"
      },
      "type": "array"
    },
    "generated_at": {
      "type": "string"
    },
    "informational_count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "inventory": {
      "items": {
        "$ref": "#/$defs/MonitoredComponent"
      },
      "type": "array"
    },
    "language": {
      "$ref": "#/$defs/Language",
      "description": "Report language from the profile; the generated sentences in this report use it."
    },
    "last_agent_review": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_scan": {
      "type": "string"
    },
    "last_successful_scan": {
      "type": [
        "string",
        "null"
      ]
    },
    "needs_review": {
      "items": {
        "$ref": "#/$defs/HandoffItem"
      },
      "type": "array"
    },
    "not_applicable_count": {
      "description": "Upstream events the agent assessed as not affecting the monitored versions; no case is opened.",
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "notification_status": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "scheduler_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "description": "Current report contract distinguishes candidates from explicitly required checks.",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "source_map": {
      "items": {
        "$ref": "#/$defs/IdentityObservation"
      },
      "type": "array"
    },
    "verification_pending": {
      "description": "Open cases whose verification is unfinished; a deliverable report requires none.",
      "items": {
        "$ref": "#/$defs/PendingVerification"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "audience",
    "language",
    "project_id",
    "project_name",
    "generated_at",
    "last_scan",
    "inventory",
    "actionable",
    "needs_review",
    "informational_count",
    "dismissed_count",
