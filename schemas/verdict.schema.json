{
  "$defs": {
    "AdvisoryTranslation": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "$ref": "#/$defs/Language"
        },
        "source_sha256": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "source_sha256",
        "language",
        "summary"
      ],
      "type": "object"
    },
    "Applicability": {
      "enum": [
        "affected",
        "not_affected",
        "possible",
        "unknown",
        "conflict"
      ],
      "type": "string"
    },
    "CodebaseRevision": {
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "codebase": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "description": "Changes excluding private paths, ignored files, generated untracked files and submodules.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "observed_at": {
          "type": "string"
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/RepositoryState"
        },
        "worktree_status_sha256": {
          "description": "Hash of Git's status entries and changed files, without retaining names or contents.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "codebase",
        "state",
        "observed_at"
      ],
      "type": "object"
    },
    "Decision": {
      "enum": [
        "actionable",
        "review",
        "informational",
        "dismissed"
      ],
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "type": "object"
    },
    "Language": {
      "enum": [
        "en",
        "es"
      ],
      "type": "string"
    },
    "RepositoryState": {
      "enum": [
        "git",
        "not_git",
        "unavailable"
      ],
      "type": "string"
    },
    "Verification": {
      "enum": [
        "source_confirmed",
        "lab_reproduced",
        "not_reproduced",
        "inconclusive",
        "disproven"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "advisory_translation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdvisoryTranslation"
        },
        {
          "type": "null"
        }
      ],
      "description": "Agent-written summary tied to one original advisory evidence document."
    },
    "applicability": {
      "$ref": "#/$defs/Applicability"
    },
    "case_id": {
      "type": "string"
    },
    "codebase_revisions": {
      "default": [],
      "description": "Recorded by the CLI from the current case.",
      "items": {
        "$ref": "#/$defs/CodebaseRevision"
      },
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "type": "array"
    },
    "facts_sha256": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "facts_sha256",
    "applicability",
    "verification",
    "decision",
    "rationale",
    "evidence"
  ],
  "title": "Verdict",
  "type": "object"
}
