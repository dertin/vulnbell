{
  "$defs": {
    "Applicability": {
      "enum": [
        "affected",
        "not_affected",
        "possible",
        "unknown",
        "conflict"
      ],
      "type": "string"
    },
    "Decision": {
      "enum": [
        "actionable",
        "review",
        "informational",
        "dismissed"
      ],
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "type": "object"
    },
    "Verification": {
      "enum": [
        "source_confirmed",
        "lab_reproduced",
        "not_reproduced",
        "inconclusive",
        "disproven"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "$ref": "#/$defs/Applicability"
    },
    "case_id": {
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "type": "array"
    },
    "facts_sha256": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "facts_sha256",
    "applicability",
    "verification",
    "decision",
    "rationale",
    "evidence"
  ],
  "title": "Verdict",
  "type": "object"
}
