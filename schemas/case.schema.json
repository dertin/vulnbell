{
  "$defs": {
    "Applicability": {
      "enum": [
        "affected",
        "not_affected",
        "possible",
        "unknown",
        "conflict"
      ],
      "type": "string"
    },
    "Claim": {
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "applicability": {
          "$ref": "#/$defs/Applicability"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "id": {
          "type": "string"
        },
        "instance_id": {
          "type": "string"
        },
        "known_exploited": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "aliases",
        "instance_id",
        "summary",
        "applicability",
        "evidence",
        "known_exploited"
      ],
      "type": "object"
    },
    "Coverage": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/CoverageState"
        }
      },
      "required": [
        "source",
        "scope",
        "state",
        "detail"
      ],
      "type": "object"
    },
    "CoverageState": {
      "enum": [
        "checked",
        "partial",
        "unsupported",
        "unavailable",
        "unresolved",
        "disabled"
      ],
      "type": "string"
    },
    "Decision": {
      "enum": [
        "actionable",
        "review",
        "informational",
        "dismissed"
      ],
      "type": "string"
    },
    "Evidence": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "observed_at": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "sha256",
        "source",
        "observed_at",
        "kind"
      ],
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "identity",
        "advisory",
        "context",
        "attestation",
        "non_applicability"
      ],
      "type": "string"
    },
    "Instance": {
      "properties": {
        "cpe_product": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "identity_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "type": "array"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "purl": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": "string"
        },
        "release": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Verified registry metadata for this exact resolved version, when available."
        },
        "requested_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "ref",
        "origin",
        "provenance",
        "identity_evidence"
      ],
      "type": "object"
    },
    "Origin": {
      "enum": [
        "declared",
        "locked",
        "agent_observed",
        "observed_artifact",
        "deployed"
      ],
      "type": "string"
    },
    "Provenance": {
      "properties": {
        "artifact_integrity": {
          "type": [
            "string",
            "null"
          ]
        },
        "direct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "line": {
          "description": "1-based line in `path` where the package entry or cited excerpt starts.\nDisplay-only: excluded from the context fingerprint so unrelated edits do not reopen cases.",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "observed_at": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": "string"
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_context_sha256": {
          "description": "Fingerprint of the Git workspaces reviewed with this inventory.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "sha256",
        "observed_at"
      ],
      "type": "object"
    },
    "ReleaseDate": {
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "published_at": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "published_at",
        "evidence"
      ],
      "type": "object"
    },
    "RepositoryState": {
      "enum": [
        "git",
        "not_git",
        "unavailable"
      ],
      "type": "string"
    },
    "SandboxAvailability": {
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "available",
        "reason"
      ],
      "type": "object"
    },
    "SourceFacts": {
      "additionalProperties": false,
      "description": "What an upstream item itself states, quoted or closely paraphrased; an empty field means the\nitem does not say. These are the item's statements, not the agent's conclusions.",
      "properties": {
        "affected_versions": {
          "default": "",
          "description": "Versions or release lines the item says are affected.",
          "type": "string"
        },
        "fix_reference": {
          "default": "",
          "description": "Pull request, commit or release that carries the fix.",
          "type": "string"
        },
        "fixed_in": {
          "default": "",
          "description": "Version, release or backport the item says contains the fix.",
          "type": "string"
        },
        "identifiers": {
          "default": [],
          "description": "CVE, GHSA, RUSTSEC or other advisory IDs the item cites.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "required_feature": {
          "default": "",
          "description": "Feature, configuration or deployment condition the item says the issue requires.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "UpstreamEvent": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "source_facts": {
          "$ref": "#/$defs/SourceFacts"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "kind",
        "id",
        "url",
        "title",
        "sha256"
      ],
      "type": "object"
    },
    "Verification": {
      "enum": [
        "source_confirmed",
        "lab_reproduced",
        "not_reproduced",
        "inconclusive",
        "disproven"
      ],
      "type": "string"
    },
    "WorkspaceRevision": {
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "description": "Changes excluding private paths, ignored files and submodule contents.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "observed_at": {
          "type": "string"
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/RepositoryState"
        },
        "workspace": {
          "type": "string"
        },
        "worktree_status_sha256": {
          "description": "Hash of Git's status entries and changed files, without retaining names or contents.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "workspace",
        "state",
        "observed_at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "applicability": {
      "$ref": "#/$defs/Applicability"
    },
    "case_id": {
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "type": "array"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/Coverage"
      },
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "type": "array"
    },
    "facts_sha256": {
      "type": "string"
    },
    "instances": {
      "items": {
        "$ref": "#/$defs/Instance"
      },
      "type": "array"
    },
    "open_questions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "project_id": {
      "type": "string"
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxAvailability"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "snapshot_id": {
      "type": "string"
    },
    "suggested_search_queries": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "updated_at": {
      "type": "string"
    },
    "upstream_events": {
      "items": {
        "$ref": "#/$defs/UpstreamEvent"
      },
      "type": "array"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    },
    "workspace_revisions": {
      "default": [],
      "description": "Git workspaces that bound the facts and review for this case.",
      "items": {
        "$ref": "#/$defs/WorkspaceRevision"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "project_id",
    "snapshot_id",
    "instances",
    "claims",
    "upstream_events",
    "evidence",
    "coverage",
    "applicability",
    "verification",
    "decision",
    "facts_sha256",
    "open_questions",
    "suggested_search_queries",
    "sandbox",
    "updated_at"
  ],
  "title": "Case",
  "type": "object"
}
