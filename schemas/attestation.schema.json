{
  "$defs": {
    "ControlObservation": {
      "properties": {
        "artifact_version": {
          "type": "string"
        },
        "input_sha256": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "oracle_matched": {
          "type": "boolean"
        },
        "output_sha256": {
          "type": "string"
        },
        "policy_verified": {
          "type": "boolean"
        }
      },
      "required": [
        "artifact_version",
        "input_sha256",
        "output_sha256",
        "oracle_matched",
        "policy_verified"
      ],
      "type": "object"
    },
    "Oracle": {
      "additionalProperties": false,
      "properties": {
        "expected_exit": {
          "format": "int32",
          "type": "integer"
        },
        "purpose": {
          "$ref": "#/$defs/OraclePurpose",
          "default": "reproduction"
        },
        "stdout_contains": {
          "type": "string"
        }
      },
      "required": [
        "stdout_contains",
        "expected_exit"
      ],
      "type": "object"
    },
    "OraclePurpose": {
      "enum": [
        "reproduction",
        "positive_non_applicability"
      ],
      "type": "string"
    },
    "RepositoryState": {
      "enum": [
        "git",
        "not_git",
        "unavailable"
      ],
      "type": "string"
    },
    "Verification": {
      "enum": [
        "source_confirmed",
        "lab_reproduced",
        "not_reproduced",
        "inconclusive",
        "disproven"
      ],
      "type": "string"
    },
    "WorkspaceRevision": {
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "description": "Changes excluding private paths, ignored files and submodule contents.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "observed_at": {
          "type": "string"
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/RepositoryState"
        },
        "workspace": {
          "type": "string"
        },
        "worktree_status_sha256": {
          "description": "Hash of Git's status entries and changed files, without retaining names or contents.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "workspace",
        "state",
        "observed_at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "control": {
      "anyOf": [
        {
          "$ref": "#/$defs/ControlObservation"
        },
        {
          "type": "null"
        }
      ]
    },
    "cpu_count": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "execution_complete": {
      "type": "boolean"
    },
    "execution_status_sha256": {
      "type": "string"
    },
    "exit_code": {
      "format": "int32",
      "type": [
        "integer",
        "null"
      ]
    },
    "facts_sha256": {
      "type": "string"
    },
    "host_mounts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "image_manifest_digest": {
      "type": "string"
    },
    "image_reference": {
      "type": "string"
    },
    "input_sha256": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "instance_id": {
      "type": "string"
    },
    "memory_mib": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "network_devices": {
      "type": "string"
    },
    "observed_at": {
      "type": "string"
    },
    "oracle": {
      "$ref": "#/$defs/Oracle"
    },
    "output_sha256": {
      "type": "string"
    },
    "policy_sha256": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "runtime": {
      "type": "string"
    },
    "runtime_sha256": {
      "type": "string"
    },
    "runtime_version": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "staging_sha256": {
      "type": "string"
    },
    "test_sha256": {
      "type": "string"
    },
    "timed_out": {
      "type": "boolean"
    },
    "timeout_seconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    },
    "workspace_revisions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WorkspaceRevision"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "case_id",
    "facts_sha256",
    "instance_id",
    "artifact_version",
    "runtime",
    "runtime_version",
    "runtime_sha256",
    "test_sha256",
    "image_reference",
    "image_manifest_digest",
    "staging_sha256",
    "policy_sha256",
    "input_sha256",
    "oracle",
    "network_devices",
    "host_mounts",
    "memory_mib",
    "cpu_count",
    "timeout_seconds",
    "output_sha256",
    "execution_status_sha256",
    "execution_complete",
    "timed_out",
    "verification",
    "observed_at"
  ],
  "title": "Attestation",
  "type": "object"
}
