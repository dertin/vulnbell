{
  "$defs": {
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "type": "object"
    },
    "ImpactAnswer": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "$ref": "#/$defs/ImpactAnswerValue"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "type": "array"
        },
        "instance_id": {
          "type": "string"
        },
        "question": {
          "$ref": "#/$defs/ImpactQuestionId"
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "question",
        "answer",
        "rationale"
      ],
      "type": "object"
    },
    "ImpactAnswerValue": {
      "enum": [
        "yes",
        "no",
        "unknown",
        "not_applicable"
      ],
      "type": "string"
    },
    "ImpactQuestionId": {
      "enum": [
        "artifact_deployed",
        "affected_feature_used",
        "untrusted_input_reaches_feature",
        "required_conditions_present",
        "fix_or_mitigation_applied"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answers": {
      "items": {
        "$ref": "#/$defs/ImpactAnswer"
      },
      "type": "array"
    },
    "case_id": {
      "type": "string"
    },
    "facts_sha256": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "facts_sha256",
    "answers"
  ],
  "title": "ImpactSubmission",
  "type": "object"
}
