{
  "$defs": {
    "Conclusion": {
      "enum": [
        "supported",
        "disputed",
        "inconclusive"
      ],
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "type": "object"
    },
    "ReviewerRelationship": {
      "enum": [
        "independent",
        "same_reviewer",
        "unknown"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string"
    },
    "conclusion": {
      "$ref": "#/$defs/Conclusion"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "type": "array"
    },
    "facts_sha256": {
      "type": "string"
    },
    "impact_sha256": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "relationship": {
      "$ref": "#/$defs/ReviewerRelationship"
    },
    "reviewer": {
      "description": "Reviewer identity as supplied by the operator, not authenticated by VulnBell.",
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "verdict_sha256": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "facts_sha256",
    "impact_sha256",
    "verdict_sha256",
    "reviewer",
    "relationship",
    "conclusion",
    "rationale",
    "evidence"
  ],
  "title": "Challenge",
  "type": "object"
}
